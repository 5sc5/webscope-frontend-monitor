# Optional process environment when starting the API directly.
# The API and setup script use defaults and do not automatically load .env.
# PowerShell example: $env:PORT = '3302'; npm run dev --workspace @webscope/server
# Set DATABASE_URL before db:setup and API startup to select another database.
# Relative paths resolve inside apps/server/prisma.
DATABASE_URL=file:./dev.db
PORT=3301
HOST=127.0.0.1
