# Optional process environment for the root development launcher.
# All services run with defaults when these variables are not set.
# npm run dev does not automatically load a root .env file.
# PowerShell example: $env:API_PORT = '3302'; npm run dev
# The launcher prints actual URLs and chooses another port when one is occupied.
API_PORT=3301
DASHBOARD_PORT=5174
PLAYGROUND_PORT=5175

# API binding; dashboard and playground remain bound to 127.0.0.1.
HOST=127.0.0.1

# Relative SQLite paths resolve inside apps/server/prisma, not the shell directory.
DATABASE_URL=file:./dev.db
